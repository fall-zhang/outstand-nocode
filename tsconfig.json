{
  "compilerOptions": {
    "baseUrl": "./",
    "target": "esnext",
    "useDefineForClassFields": true,
    "module": "esnext",
    "moduleResolution": "node",
    "strict": true,
    "jsx": "preserve",
    "jsxImportSource": "vue",
    "noEmit": true, // 编译时取消生成 js 文件
    "declaration": false, // 生成 .d.ts 文件
    "sourceMap": true,
    "allowJs": true,
    "skipLibCheck": true, // 跳过 lib 检查
    "resolveJsonModule": true,
    // "isolatedModules": true, // 因为 esbuild 暂时不支持 enum，所以，暂时设置为 false
    "isolatedModules": false,
    "esModuleInterop": true,
    "types": [
      "vite/client",
      "element-plus/global"
    ],
    "lib": [
      "esnext",
      "dom"
    ],
    "paths": {
      "@/*": [
        "src/*"
      ],
      "@C/*": [
        "src/components/*"
      ],
      "@A/*": [
        "src/assets/*"
      ],
      "@V/*": [
        "src/views/*"
      ],
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.d.ts",
    "src/**/*.tsx",
    "src/**/*.vue"
  ],
  "references": [
    {
      "path": "./tsconfig.node.json"
    }
  ]
}